+import com.raoulvdberge.refinedstorage.block.BlockNode;
+import com.zengyj.exposer.handler.AE2FluidHandler;
+import net.minecraft.block.material.Material;
+import net.minecraft.block.state.IBlockState;
+import net.minecraft.entity.EntityLivingBase;
+import net.minecraft.entity.player.EntityPlayer;
+import net.minecraft.item.ItemStack;
+import net.minecraft.nbt.NBTTagCompound;
+import net.minecraft.util.math.BlockPos;
+import net.minecraft.world.World;
+
+import javax.annotation.Nonnull;
+import javax.annotation.Nullable;
+import java.util.UUID;
+
+public class BlockFluidConnector extends AEBaseTileBlock implements INetworkNode {
+    private INetwork rsNetwork;
+    private BlockPos pos;
+    private World world;
+//    private UUID owner;
+    public BlockFluidConnector() {
+        super(Material.IRON);
+        setTileEntity(AE2FluidHandler.class);
+    }
+
+    @Override
+    public int getEnergyUsage() {
+        return 1;
+    }
+
+    @Nonnull
+    @Override
+    public ItemStack getItemStack() {
+        return new ItemStack(blockState.getBlock(),1);
+    }
+
+    @Override
+    public void onConnected(INetwork iNetwork) {
+        this.rsNetwork = iNetwork;
+    }
+
+    @Override
+    public void onDisconnected(INetwork iNetwork) {
+        this.rsNetwork = null;
+    }
+
+    @Override
+    public boolean canUpdate() {
+        return rsNetwork != null;
+    }
+
+    @Nullable
+    @Override
+    public INetwork getNetwork() {
+        return this.rsNetwork;
+    }
+
+    @Override
+    public void update() {
+
+    }
+
+    @Override
+    public NBTTagCompound write(NBTTagCompound nbtTagCompound) {
+        return new NBTTagCompound();
+    }
+
+    @Override
+    public BlockPos getPos() {
+        return this.pos;
+    }
+
+    @Override
+    public World getWorld() {
+        return world;
+    }
+
+    @Override
+    public void markDirty() {
+
+    }
+
+    @Override
+    public String getId() {
+        return "fluidconnector";
+    }
+
+    @Override
+    public void onBlockPlacedBy(World w, BlockPos pos, IBlockState state, EntityLivingBase placer, ItemStack is) {
+        this.pos = pos;
+        this.world = w;
+//        if (placer instanceof EntityPlayer){
+//            owner = placer.getUniqueID();
+//        }
+    }
+}
